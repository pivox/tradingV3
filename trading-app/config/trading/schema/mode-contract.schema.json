{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pivox.local/schemas/trading/mode-contract/1.0.0",
  "title": "Pivox modern trading mode contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode_id", "mode_version", "lifecycle", "horizon", "session_policy", "timeframes", "cadence", "risk", "leverage", "order_policy", "compatible_setup_ids", "data_contract", "governance", "ownership_model", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mode_id": { "enum": ["day_trading", "scalping", "micro_scalping"] },
    "mode_version": { "enum": ["1.0.0", "1.1.0"] },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "executable", "rationale"],
      "properties": {
        "status": { "enum": ["draft", "shadow", "paper", "candidate", "active", "retired"] },
        "executable": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [{ "if": { "properties": { "status": { "enum": ["draft", "retired"] } }, "required": ["status"] }, "then": { "properties": { "executable": { "const": false } } } }]
    },
    "horizon": { "oneOf": [
      { "allOf": [{ "$ref": "#/$defs/stringDecision" }, { "properties": { "unit": { "const": "holding_horizon_policy" } } }] },
      { "allOf": [{ "$ref": "#/$defs/shadowHorizonDecision" }, { "properties": { "unit": { "const": "holding_horizon_policy" } } }] }
    ] },
    "session_policy": { "oneOf": [
      { "allOf": [{ "$ref": "#/$defs/stringDecision" }, { "properties": { "unit": { "const": "session_policy" } } }] },
      { "allOf": [{ "$ref": "#/$defs/shadowSessionDecision" }, { "properties": { "unit": { "const": "session_policy" } } }] }
    ] },
    "timeframes": {
      "type": "object", "additionalProperties": false,
      "required": ["regime", "context", "trigger", "execution"],
      "properties": {
        "regime": { "$ref": "#/$defs/timeframeList" },
        "context": { "$ref": "#/$defs/timeframeList" },
        "trigger": { "$ref": "#/$defs/timeframeList" },
        "execution": { "$ref": "#/$defs/timeframeList" },
        "confirmations": { "$ref": "#/$defs/timeframeList" }
      }
    },
    "cadence": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation", "validity_window"],
      "properties": {
        "evaluation": { "allOf": [{ "$ref": "#/$defs/durationDecision" }, { "properties": { "unit": { "const": "duration" } } }] },
        "validity_window": { "allOf": [{ "$ref": "#/$defs/durationDecision" }, { "properties": { "unit": { "const": "duration" } } }] }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["trade_budget", "daily_loss_cap", "max_concurrent_positions", "mode_exposure_cap"],
      "properties": {
        "trade_budget": { "oneOf": [
          { "allOf": [{ "$ref": "#/$defs/positiveNumberDecision" }, { "properties": { "unit": { "const": "percent_equity_per_trade" } } }] },
          { "allOf": [{ "$ref": "#/$defs/quoteBudgetDecision" }, { "properties": { "unit": { "const": "quote_notional" } } }] }
        ] },
        "daily_loss_cap": { "allOf": [{ "$ref": "#/$defs/dailyCapDecision" }, { "properties": { "unit": { "const": "compound_percent_equity_and_quote_per_day" } } }] },
        "max_concurrent_positions": { "oneOf": [
          { "allOf": [{ "$ref": "#/$defs/positiveIntegerDecision" }, { "properties": { "unit": { "const": "positions" } } }] },
          { "allOf": [{ "$ref": "#/$defs/shadowConcurrencyDecision" }, { "properties": { "unit": { "const": "positions" } } }] }
        ] },
        "mode_exposure_cap": { "allOf": [{ "$ref": "#/$defs/positiveNumberDecision" }, { "properties": { "unit": { "const": "percent_equity_notional" } } }] }
      }
    },
    "leverage": { "allOf": [{ "$ref": "#/$defs/positiveNumberDecision" }, { "properties": { "unit": { "const": "leverage_multiple" } } }] },
    "order_policy": { "allOf": [{ "$ref": "#/$defs/orderDecision" }, { "properties": { "unit": { "const": "policy" } } }] },
    "compatible_setup_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(day_trading|scalping|micro_scalping)\\.[a-z0-9_]+\\.(long|short)$" } },
    "data_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["required_inputs", "missing_data_policy"],
      "properties": {
        "required_inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dataInput" } },
        "missing_data_policy": { "const": "reject" }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["promotion", "suspension", "rollback"],
      "properties": {
        "promotion": { "allOf": [{ "$ref": "#/$defs/governanceRule" }, { "properties": { "target_status": { "const": "shadow" } } }] },
        "suspension": { "allOf": [{ "$ref": "#/$defs/governanceRule" }, { "properties": { "target_status": { "const": "draft" } } }] },
        "rollback": { "allOf": [{ "$ref": "#/$defs/governanceRule" }, { "properties": { "target_status": { "const": "retired" } } }] }
      }
    },
    "ownership_model": { "const": "mode-contract-ownership-v1" },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }
  },
  "allOf": [
    { "if": { "properties": { "mode_id": { "const": "day_trading" } }, "required": ["mode_id"] }, "then": { "properties": { "mode_version": { "enum": ["1.0.0", "1.1.0"] }, "compatible_setup_ids": { "const": ["day_trading.trend_continuation.long", "day_trading.trend_continuation.short"] } } } },
    { "if": { "properties": { "mode_id": { "const": "scalping" } }, "required": ["mode_id"] }, "then": { "properties": { "mode_version": { "enum": ["1.0.0", "1.1.0"] }, "compatible_setup_ids": { "const": ["scalping.trend_continuation.long", "scalping.pullback.long", "scalping.trend_momentum.short"] } } } },
    { "if": { "properties": { "mode_id": { "const": "micro_scalping" } }, "required": ["mode_id"] }, "then": { "properties": { "mode_version": { "const": "1.0.0" }, "compatible_setup_ids": { "const": ["micro_scalping.momentum_ofi.long", "micro_scalping.momentum_ofi.short"] } } } },
    { "if": { "properties": { "mode_id": { "const": "day_trading" }, "mode_version": { "const": "1.1.0" } }, "required": ["mode_id", "mode_version"] }, "then": {
      "properties": {
        "lifecycle": { "properties": { "status": { "const": "shadow" }, "executable": { "const": true } } },
        "horizon": { "required": ["state", "value", "unit"], "properties": { "state": { "const": "defined" }, "value": { "const": { "maximum_duration": "PT8H", "daily_boundary_time": "00:00:00", "daily_boundary_timezone": "UTC", "close_before_boundary": true } }, "unit": { "const": "holding_horizon_policy" } } },
        "session_policy": { "required": ["state", "value", "unit"], "properties": { "state": { "const": "defined" }, "value": { "const": { "calendar": "continuous_crypto", "timezone": "UTC" } }, "unit": { "const": "session_policy" } } },
        "timeframes": { "required": ["regime", "context", "trigger", "execution", "confirmations"], "properties": { "regime": { "const": ["4h"] }, "context": { "const": ["1h"] }, "trigger": { "const": ["15m"] }, "execution": { "const": ["15m"] }, "confirmations": { "const": ["5m", "1m"] } } },
        "cadence": { "properties": { "evaluation": { "properties": { "state": { "const": "defined" }, "value": { "const": "PT15M" } } }, "validity_window": { "properties": { "state": { "const": "defined" }, "value": { "const": "PT15M" } } } } },
        "risk": { "properties": { "trade_budget": { "properties": { "state": { "const": "defined" }, "value": { "const": 5.0 }, "unit": { "const": "percent_equity_per_trade" } } }, "daily_loss_cap": { "properties": { "state": { "const": "defined" }, "value": { "const": { "percent_equity": 6.0, "absolute_quote": 30.0, "quote_currency": "USDT", "day_timezone": "UTC", "day_boundary_local": "00:00:00", "include_unrealized_loss": true } } } }, "max_concurrent_positions": { "properties": { "state": { "const": "defined" }, "value": { "const": { "limit": 4, "include_pending_entries": true } } } }, "mode_exposure_cap": { "properties": { "state": { "const": "defined" }, "value": { "const": 100.0 } } } } },
        "leverage": { "properties": { "state": { "const": "defined" }, "value": { "const": 2.0 } } },
        "order_policy": { "properties": { "state": { "const": "defined" }, "value": { "const": { "margin_mode": "isolated", "preferred_type": "limit", "market_fallback": false } } } }
      }
    } },
    { "if": { "properties": { "mode_id": { "const": "scalping" }, "mode_version": { "const": "1.1.0" } }, "required": ["mode_id", "mode_version"] }, "then": {
      "properties": {
        "lifecycle": { "properties": { "status": { "const": "shadow" }, "executable": { "const": true } } },
        "horizon": { "required": ["state", "value", "unit"], "properties": { "state": { "const": "defined" }, "value": { "const": { "maximum_duration": "PT2H", "daily_boundary_time": "00:00:00", "daily_boundary_timezone": "UTC", "close_before_boundary": true } }, "unit": { "const": "holding_horizon_policy" } } },
        "session_policy": { "required": ["state", "value", "unit"], "properties": { "state": { "const": "defined" }, "value": { "const": { "calendar": "continuous_crypto", "timezone": "UTC" } }, "unit": { "const": "session_policy" } } },
        "timeframes": { "required": ["regime", "context", "trigger", "execution", "confirmations"], "properties": { "regime": { "const": ["1h"] }, "context": { "const": ["15m"] }, "trigger": { "const": ["5m"] }, "execution": { "const": ["5m"] }, "confirmations": { "const": ["1m"] } } },
        "cadence": { "properties": { "evaluation": { "properties": { "state": { "const": "defined" }, "value": { "const": "PT5M" } } }, "validity_window": { "properties": { "state": { "const": "defined" }, "value": { "const": "PT5M" } } } } },
        "risk": { "properties": { "trade_budget": { "properties": { "state": { "const": "defined" }, "value": { "const": 2.0 }, "unit": { "const": "percent_equity_per_trade" } } }, "daily_loss_cap": { "properties": { "state": { "const": "defined" }, "value": { "const": { "percent_equity": 6.0, "absolute_quote": 40.0, "quote_currency": "USDT", "day_timezone": "UTC", "day_boundary_local": "00:00:00", "include_unrealized_loss": true } } } }, "max_concurrent_positions": { "properties": { "state": { "const": "defined" }, "value": { "const": { "limit": 3, "include_pending_entries": true } } } }, "mode_exposure_cap": { "properties": { "state": { "const": "defined" }, "value": { "const": 75.0 } } } } },
        "leverage": { "properties": { "state": { "const": "defined" }, "value": { "const": 3.0 } } },
        "order_policy": { "properties": { "state": { "const": "defined" }, "value": { "const": { "margin_mode": "isolated", "preferred_type": "limit", "market_fallback": false } } } }
      }
    } },
    { "if": { "properties": { "mode_version": { "const": "1.0.0" } }, "required": ["mode_version"] }, "then": { "properties": { "timeframes": { "not": { "required": ["confirmations"] } } } } },
    { "if": { "properties": { "mode_version": { "const": "1.1.0" } }, "required": ["mode_version"] }, "then": { "properties": { "timeframes": { "required": ["confirmations"] } } } }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "pattern": "\\S" },
    "timeframeList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["4h", "1h", "15m", "5m", "1m"] } },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value", "unit", "source", "justification"],
      "properties": {
        "state": { "enum": ["defined", "unresolved"] },
        "value": {},
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "justification": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "unresolved" } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "null" } } } },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "not": { "type": "null" } } } } }
      ]
    },
    "stringDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "$ref": "#/$defs/nonEmptyString" } } } }
      ]
    },
    "durationDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "string", "pattern": "^P(?=[0-9]|T[0-9])(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?(?:T(?=[0-9])(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$" } } } }
      ]
    },
    "shadowHorizonDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "properties": { "state": { "const": "defined" }, "value": { "$ref": "#/$defs/shadowHorizon" } } }
      ]
    },
    "shadowHorizon": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_duration", "daily_boundary_time", "daily_boundary_timezone", "close_before_boundary"],
      "properties": {
        "maximum_duration": { "enum": ["PT8H", "PT2H"] },
        "daily_boundary_time": { "const": "00:00:00" },
        "daily_boundary_timezone": { "const": "UTC" },
        "close_before_boundary": { "const": true }
      }
    },
    "shadowSessionDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "properties": { "state": { "const": "defined" }, "value": { "$ref": "#/$defs/shadowSession" } } }
      ]
    },
    "shadowSession": {
      "type": "object", "additionalProperties": false,
      "required": ["calendar", "timezone"],
      "properties": { "calendar": { "const": "continuous_crypto" }, "timezone": { "const": "UTC" } }
    },
    "positiveNumberDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "number", "exclusiveMinimum": 0 } } } }
      ]
    },
    "positiveIntegerDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "integer", "minimum": 1 } } } }
      ]
    },
    "shadowConcurrencyDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "properties": { "state": { "const": "defined" }, "value": { "$ref": "#/$defs/shadowConcurrency" } } }
      ]
    },
    "shadowConcurrency": {
      "type": "object", "additionalProperties": false,
      "required": ["limit", "include_pending_entries"],
      "properties": { "limit": { "enum": [3, 4] }, "include_pending_entries": { "const": true } }
    },
    "dailyCapDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "$ref": "#/$defs/dailyCap" } } } }
      ]
    },
    "quoteBudgetDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "$ref": "#/$defs/quoteBudget" } } } }
      ]
    },
    "quoteBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "quote_currency"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "quote_currency": { "const": "USDT" }
      }
    },
    "dailyCap": { "oneOf": [
      {
        "type": "object", "additionalProperties": false,
        "required": ["percent_equity", "absolute_quote", "quote_currency"],
        "properties": {
          "percent_equity": { "type": "number", "exclusiveMinimum": 0 },
          "absolute_quote": { "type": "number", "exclusiveMinimum": 0 },
          "quote_currency": { "const": "USDT" }
        }
      },
      {
        "type": "object", "additionalProperties": false,
        "required": ["percent_equity", "absolute_quote", "quote_currency", "day_timezone", "day_boundary_local", "include_unrealized_loss"],
        "properties": {
          "percent_equity": { "type": "number", "exclusiveMinimum": 0 },
          "absolute_quote": { "type": "number", "exclusiveMinimum": 0 },
          "quote_currency": { "const": "USDT" },
          "day_timezone": { "const": "UTC" },
          "day_boundary_local": { "const": "00:00:00" },
          "include_unrealized_loss": { "const": true }
        }
      }
    ] },
    "orderDecision": {
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "if": { "properties": { "state": { "const": "defined" } }, "required": ["state"] }, "then": { "properties": { "value": { "$ref": "#/$defs/orderPolicy" } } } }
      ]
    },
    "orderPolicy": { "oneOf": [
      {
        "type": "object", "additionalProperties": false,
        "required": ["margin_mode", "preferred_type"],
        "properties": { "margin_mode": { "enum": ["isolated", "cross"] }, "preferred_type": { "enum": ["limit", "market"] } }
      },
      {
        "type": "object", "additionalProperties": false,
        "required": ["margin_mode", "preferred_type", "market_fallback"],
        "properties": { "margin_mode": { "const": "isolated" }, "preferred_type": { "const": "limit" }, "market_fallback": { "const": false } }
      }
    ] },
    "dataInput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "timeframes", "fields"],
      "properties": {
        "kind": { "enum": ["candles", "order_book"] },
        "timeframes": { "$ref": "#/$defs/timeframeList" },
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "governanceRule": {
      "type": "object", "additionalProperties": false,
      "required": ["target_status", "conditions", "action"],
      "properties": {
        "target_status": { "enum": ["draft", "shadow", "paper", "candidate", "active", "retired"] },
        "conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "action": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source", "unit", "justification"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "justification": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
